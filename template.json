        ],
        "Events": {
          "Http": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "Api"
              },
              "Path": "/api/v1/worker/{id}/contact",
              "Method": "POST"
            }
          }
        }
      }
    },
    "ReviewFn": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "moderate.handler",
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:GetItem",
                  "dynamodb:Query",
                  "dynamodb:BatchGetItem",
                  "dynamodb:UpdateItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "Workers",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::Sub": "${Workers.Arn}/index/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:UpdateItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "State",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::Sub": "${State.Arn}/index/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:Query"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "Jobs",
                    "Arn"
                  ]
                }
              }
            ]
          }
        ],
        "Events": {
          "Http": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "Api"
              },
              "Path": "/api/v1/admin/workers",
              "Method": "GET"
            }
          },
          "Decide": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "Api"
              },
              "Path": "/api/v1/admin/worker/{id}",
              "Method": "PATCH"
            }
          }
        }
      }
    },
    "OutcomeFn": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "enquiries.handler",
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:GetItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "Workers",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::Sub": "${Workers.Arn}/index/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:UpdateItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "State",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::Sub": "${State.Arn}/index/*"
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:UpdateItem"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "Jobs",
                    "Arn"
                  ]
                }
              }
            ]
          }
        ],
        "Events": {
          "Http": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "Api"
              },
              "Path": "/api/v1/enquiry/{id}",
              "Method": "PATCH"
            }
          }
        }
      }
    },
    "SpeechFn": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "speech.handler",
        "Timeout": 29,
        "Environment": {
          "Variables": {
            "BHASHINI_PARAMETER": {
              "Ref": "BhashiniParameter"
            }
          }
        },
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:UpdateItem"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "State",
                    "Arn"
                  ]
                }
              },
              {
                "Effect": "Allow",
                "Action": [
                  "ssm:GetParameter"
                ],
                "Resource": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/*"
                }
              }
            ]
          }
        ],
        "Events": {
          "Http": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "Api"
              },
              "Path": "/api/v1/speech",
              "Method": "POST"
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "AppId": {
      "Value": {
        "Fn::GetAtt": [
          "Host",
          "AppId"
        ]
      }
    },
    "PublicUrl": {
      "Value": {
        "Fn::Sub": "https://main.${Host.DefaultDomain}"
      }
    },
    "ApiBase": {
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.${AWS::URLSuffix}/api/v1"
      }
    }
  }
}
